# Docker Compose 中的 PostgreSQL
POSTGRES_DB=quiz
POSTGRES_USER=quiz
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# 应用配置
TEACHER_PASSWORD=replace-with-a-strong-teacher-password
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_RETENTION_DAYS=365
DATABASE_POOL_MAX=20
APP_PORT=80

# 仅在本机直接运行 pnpm dev 时使用
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=quiz
PGUSER=quiz
PGPASSWORD=replace-with-a-long-url-safe-password

# 使用云数据库时可改为单个连接地址；它的优先级高于上面的 PG* 参数
# DATABASE_URL=postgresql://user:password@host:5432/quiz
